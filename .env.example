# ===================================================
# Senari Chinese Hotel — Backend Environment
# ===================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control!
# ===================================================

# ─── Environment ───────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database (MySQL) ─────────────────────────────
DATABASE_URL="mysql://root:your_password@localhost:3306/senari_db"

# ─── CORS / Frontend URL ─────────────────────────
FRONTEND_URL=http://localhost:5173